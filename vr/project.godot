; Embodiment Lab VR / Rubber Hand Illusion - Android OpenXR
config_version=5

[application]
config/name="Embodiment Lab Quest VR"
run/main_scene="res://scenes/Main.tscn"
config/description="Эксперимент эффекта резиновой руки в VR"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/handheld/orientation=1

[xr]
openxr/enabled=true
openxr/alert_on_startup=true
openxr/form_factor=0
openxr/view_configuration=1
openxr/environment_blend_mode=0
shaders/enabled=true

[editor_plugins]
enabled=PackedStringArray("res://addons/godotopenxrvendors/plugin.cfg")

[rendering/textures]

vram_compression/import_etc2_astc=true
